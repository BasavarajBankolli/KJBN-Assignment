# Food Truck Finder - Frontend environment configuration
# Copy this file to .env.local and adjust values as needed.
#
# Only VITE_-prefixed variables are exposed to the browser bundle.
# Set this to the backend URL. For local development the backend runs on
# http://localhost:8000. In production, point it at your deployed API
# (e.g. https://your-api.onrender.com). Leave empty to call the same origin
# (useful behind a reverse proxy / Vercel rewrite).
VITE_API_BASE_URL=http://localhost:8000
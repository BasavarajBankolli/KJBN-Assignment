# ------------------------------------------------------------------
# Food Truck Finder - Backend environment configuration
# Copy this file to .env (next to this file) and adjust values as needed.
# All variables are optional - the app runs on sane defaults.
# ------------------------------------------------------------------

# Application
APP_ENV=development
LOG_LEVEL=INFO

# DataSF Food Trucks API
DATASF_BASE_URL=https://data.sfgov.org/resource/rqzj-sfat.json
DATASF_TIMEOUT_SECONDS=10

# Caching (0 disables the in-process TTL cache)
CACHE_TTL_SECONDS=300

# CORS (comma-separated list of allowed browser origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173